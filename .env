# =============================================================================
# Shared defaults — loaded by Vite in ALL modes.
# Mode-specific overrides live in .env.development and .env.production.
# Create a .env.local (git-ignored) to override any value on your machine.
# =============================================================================

# Target the dev proxy forwards API requests to (see vite.config.js).
# Only used in development, but kept here as a sensible default.
VITE_API_TARGET=http://localhost:8000
