# =============================================================================
# Production — used by `npm run build` (Vite mode: production).
# =============================================================================
# In a production build there is no dev proxy, so the app calls the deployed
# backend directly. No trailing slash (paths already start with "/").
VITE_API_BASE_URL=https://ai-hackathon-evaluator-backend-835728304610.asia-south1.run.app

# NOTE: Because auth uses an HttpOnly cookie sent cross-origin, the backend must:
#   - allow credentialed CORS from this app's origin
#     (Access-Control-Allow-Origin: <your-frontend-origin>,
#      Access-Control-Allow-Credentials: true)
#   - set the session cookie with SameSite=None; Secure
# If the frontend is served from the same origin as the API, you can instead
# leave VITE_API_BASE_URL empty and reverse-proxy the API paths.
