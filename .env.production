# =============================================================================
# Production — used by `npm run build` (Vite mode: production).
# =============================================================================
# Production requests use Vercel's same-origin /api rewrite. This lets the
# browser store both auth cookies for the frontend host and read csrf_token.
VITE_API_BASE_URL=/api

# The backend cookies must use Path=/ and must not set Domain to the Cloud Run
# hostname, otherwise the browser will reject them on the proxied response.
