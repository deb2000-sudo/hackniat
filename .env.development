# =============================================================================
# Development — used by `npm run dev` (Vite mode: development).
# =============================================================================
# Left empty so the app calls same-origin paths (e.g. /auth/login). The Vite
# dev server proxies those to VITE_API_TARGET, keeping the HttpOnly auth cookie
# same-origin so it is stored and sent correctly.
VITE_API_BASE_URL=

# Local FastAPI backend the dev proxy forwards to.
VITE_API_TARGET=http://localhost:8000
