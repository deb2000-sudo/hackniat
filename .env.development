# =============================================================================
# Development — used by `npm run dev` (Vite mode: development).
# =============================================================================
# Leave EMPTY so the app calls same-origin paths (e.g. /auth/login). The Vite
# dev server proxies those to VITE_API_TARGET. Calling Cloud Run directly from
# the browser breaks cookie/CSRF (document.cookie cannot read cross-origin).
VITE_API_BASE_URL=

# Local FastAPI backend the dev proxy forwards to.
VITE_API_TARGET=http://localhost:8000
