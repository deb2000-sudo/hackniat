# =============================================================================
# Example environment configuration. Copy to .env.local to override locally.
# Vite exposes only variables prefixed with VITE_ to the client.
# =============================================================================

# Base URL of the backend API.
#   - Development: leave EMPTY to use the same-origin Vite dev proxy.
#   - Production : set to the deployed API origin (no trailing slash), e.g.
#     https://ai-hackathon-evaluator-backend-835728304610.asia-south1.run.app
VITE_API_BASE_URL=

# Where the dev server proxy forwards API requests (development only).
VITE_API_TARGET=http://localhost:8000
